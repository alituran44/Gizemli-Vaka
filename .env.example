# Gizemli Vaka - Ortam Değişkenleri Şablonu (.env)

# Uygulama Ayarları
SESSION_SECRET=dev-secret-key-change-in-production
FLASK_ENV=development
IS_PRODUCTION=0

# Veritabanı Ayarları (Boş bırakılırsa varsayılan olarak SQLite kullanır: sqlite:///database.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/gizemli_vaka

# AI Anahtarları (Google Gemini ve OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Ödeme Entegrasyonları (Param POS, PaynKolay, iyzico)
PARAM_CLIENT_CODE=
PARAM_CLIENT_USERNAME=
PARAM_CLIENT_PASSWORD=
PARAM_GUID=

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com

PAYNKOLAY_MERCHANT_ID=
PAYNKOLAY_SECRET_KEY=

# E-posta Ayarları (Flask-Mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
